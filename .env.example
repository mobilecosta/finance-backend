# Supabase Auth
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua_chave_anonima"
SUPABASE_SERVICE_ROLE="sua_service_role_key"

# PostgreSQL (via Supabase pooler)
DATABASE_URL="postgresql://user:pass@host:5432/postgres?pgbouncer=true"

# ACBr API (NFS-e)
ACBR_BASE_URL="https://proxy.api.acbr.net.br"
ACBR_CLIENT_ID="seu-client-id"
ACBR_CLIENT_SECRET="seu-client-secret"

# Email (relatórios)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha"

# General
PORT=3000
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

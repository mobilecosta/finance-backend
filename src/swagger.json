{
  "openapi": "3.0.0",
  "info": {
    "title": "Finance Pro API",
    "version": "1.0.0",
    "description": "Documentação da API do sistema Finance Pro Mobile"
  },
  "servers": [
    {
      "url": "https://finance-backend-mobile.vercel.app",
      "description": "Servidor de Produção (Vercel)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "summary": "Criar novo usuário",
        "tags": ["Autenticação"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "fullName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso" }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "summary": "Autenticar usuário",
        "tags": ["Autenticação"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso" }
        }
      }
    },
    "/api/finance/dashboard/metrics": {
      "get": {
        "summary": "Obter métricas do dashboard",
        "tags": ["Finanças"],
        "responses": {
          "200": { "description": "Métricas retornadas com sucesso" }
        }
      }
    },
    "/api/finance/transactions": {
      "get": {
        "summary": "Listar transações do usuário",
        "tags": ["Finanças"],
        "responses": {
          "200": { "description": "Lista de transações" }
        }
      },
      "post": {
        "summary": "Criar nova transação",
        "tags": ["Finanças"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": { "type": "integer" },
                  "categoryId": { "type": "integer" },
                  "type": { "type": "string", "enum": ["income", "expense"] },
                  "amount": { "type": "number" },
                  "description": { "type": "string" },
                  "date": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Transação criada" }
        }
      }
    },
    "/api/finance/transactions/{id}": {
      "put": {
        "summary": "Atualizar transação",
        "tags": ["Finanças"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": { "type": "integer" },
                  "categoryId": { "type": "integer" },
                  "type": { "type": "string", "enum": ["income", "expense"] },
                  "amount": { "type": "number" },
                  "description": { "type": "string" },
                  "date": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Transação atualizada" }
        }
      },
      "delete": {
        "summary": "Excluir transação",
        "tags": ["Finanças"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Transação excluída" }
        }
      }
    },
    "/api/migration/sheet-preview": {
      "get": {
        "summary": "Prévia de migração de aba do Google Sheets",
        "description": "Lê uma aba direto da API do Google (CSV público via gviz, sem API key, modelo dashboard_totvs) e devolve as linhas normalizadas no formato da rotina de transações: datas ISO (coluna de data ou DIA + competência MM/YYYY da aba), valores pt-BR, par VLR DESPESA/VLR RECEITA, ignorando TOTAIS DO MÊS e ecos de SALDO.",
        "tags": ["Migração"],
        "parameters": [
          { "name": "tab", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Nome da aba (ex.: 01-2026).", "example": "01-2026" },
          { "name": "spreadsheetId", "in": "query", "required": false, "schema": { "type": "string" }, "description": "ID da planilha. Padrão: planilha de migração 2026." },
          { "name": "typeMode", "in": "query", "required": false, "schema": { "type": "string", "enum": ["column", "signal", "fixed-income", "fixed-expense"], "default": "signal" }, "description": "Como definir income/expense." },
          { "name": "colDate", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Override do cabeçalho da data." },
          { "name": "colDay", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Override do cabeçalho do dia (ex.: DIA)." },
          { "name": "colDescription", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colAmount", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colAmountExpense", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colAmountIncome", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colType", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colCategory", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "colStatus", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 200 }, "description": "Máximo de linhas retornadas (1-1000)." }
        ],
        "responses": {
          "200": { "description": "Prévia normalizada: headers, rows, totais, issues (level error/warning)." },
          "400": { "description": "Parâmetro tab ausente." },
          "401": { "description": "Sem token Bearer (resposta sem corpo)." },
          "502": { "description": "Planilha indisponível sem login (compartilhar como Leitor)." }
        }
      }
    },
    "/api/acbr/auth": {
      "post": {
        "summary": "Autenticar na ACBr API",
        "tags": ["ACBr"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_id": { "type": "string", "description": "Client ID fornecido pela ACBr" },
                  "client_secret": { "type": "string", "description": "Client Secret fornecido pela ACBr" }
                },
                "required": ["client_id", "client_secret"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de acesso retornado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "expires_in": { "type": "integer" }
                  }
                }
              }
            }
          },
          "502": { "description": "Falha na autenticação com ACBr" }
        }
      }
    },
    "/api/acbr/empresas": {
      "get": {
        "summary": "Listar empresas (proxy ACBr)",
        "tags": ["ACBr"],
        "parameters": [
          { "name": "$top", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "Limite de registros" },
          { "name": "$skip", "in": "query", "schema": { "type": "integer", "default": 0 }, "description": "Registros a pular" },
          { "name": "cpf_cnpj", "in": "query", "schema": { "type": "string" }, "description": "Filtrar por CPF/CNPJ" },
          { "name": "nome_razao_social", "in": "query", "schema": { "type": "string" }, "description": "Filtrar por nome/razão social" },
          { "name": "ambiente", "in": "query", "schema": { "type": "string", "enum": ["homologacao", "producao"], "default": "homologacao" } }
        ],
        "responses": {
          "200": { "description": "Lista de empresas" },
          "502": { "description": "Erro na comunicação com ACBr" }
        }
      },
      "post": {
        "summary": "Cadastrar empresa (proxy ACBr)",
        "tags": ["ACBr"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf_cnpj": { "type": "string" },
                  "nome_razao_social": { "type": "string" },
                  "nome_fantasia": { "type": "string" },
                  "email": { "type": "string" },
                  "fone": { "type": "string" },
                  "inscricao_estadual": { "type": "string" },
                  "inscricao_municipal": { "type": "string" },
                  "endereco": {
                    "type": "object",
                    "properties": {
                      "logradouro": { "type": "string" },
                      "numero": { "type": "string" },
                      "complemento": { "type": "string" },
                      "bairro": { "type": "string" },
                      "codigo_municipio": { "type": "string" },
                      "cidade": { "type": "string" },
                      "uf": { "type": "string" },
                      "cep": { "type": "string" },
                      "codigo_pais": { "type": "string", "default": "1058" },
                      "pais": { "type": "string", "default": "Brasil" }
                    }
                  }
                },
                "required": ["cpf_cnpj", "nome_razao_social", "email", "endereco"]
              }
            }
          }
        },
        "parameters": [
          { "name": "ambiente", "in": "query", "schema": { "type": "string", "enum": ["homologacao", "producao"], "default": "homologacao" } }
        ],
        "responses": {
          "200": { "description": "Empresa cadastrada" },
          "502": { "description": "Erro na comunicação com ACBr" }
        }
      }
    },
    "/api/acbr/empresas/{cpf_cnpj}": {
      "get": {
        "summary": "Consultar empresa (proxy ACBr)",
        "tags": ["ACBr"],
        "parameters": [
          { "name": "cpf_cnpj", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "ambiente", "in": "query", "schema": { "type": "string", "enum": ["homologacao", "producao"], "default": "homologacao" } }
        ],
        "responses": {
          "200": { "description": "Dados da empresa" },
          "502": { "description": "Erro na comunicação com ACBr" }
        }
      },
      "put": {
        "summary": "Alterar empresa (proxy ACBr)",
        "tags": ["ACBr"],
        "parameters": [
          { "name": "cpf_cnpj", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "ambiente", "in": "query", "schema": { "type": "string", "enum": ["homologacao", "producao"], "default": "homologacao" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf_cnpj": { "type": "string" },
                  "nome_razao_social": { "type": "string" },
                  "nome_fantasia": { "type": "string" },
                  "email": { "type": "string" },
                  "fone": { "type": "string" },
                  "inscricao_estadual": { "type": "string" },
                  "inscricao_municipal": { "type": "string" },
                  "endereco": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Empresa alterada" },
          "502": { "description": "Erro na comunicação com ACBr" }
        }
      },
      "delete": {
        "summary": "Deletar empresa (proxy ACBr)",
        "tags": ["ACBr"],
        "parameters": [
          { "name": "cpf_cnpj", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "ambiente", "in": "query", "schema": { "type": "string", "enum": ["homologacao", "producao"], "default": "homologacao" } }
        ],
        "responses": {
          "204": { "description": "Empresa deletada" },
          "502": { "description": "Erro na comunicação com ACBr" }
        }
      }
    },
    "/api/acbr/empresas/{cpf_cnpj}/certificado": {

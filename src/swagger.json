    "/api/acbr-tests/run": {
      "post": {
        "summary": "Executar todos os testes ACBr (16 testes, 6 suítes)",
        "tags": ["ACBr"],
        "security": [],
        "responses": {
          "200": {
            "description": "Testes executados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "passed": { "type": "integer" },
                        "failed": { "type": "integer" },
                        "durationMs": { "type": "integer" },
                        "suites": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "passed": { "type": "integer" },
                              "failed": { "type": "integer" },
                              "total": { "type": "integer" }
                            }
                          }
                        }
                      }
                    },
                    "reportHtml": { "type": "string", "description": "Relatório HTML completo dos testes" },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "suite": { "type": "string" },
                          "name": { "type": "string" },
                          "method": { "type": "string" },
